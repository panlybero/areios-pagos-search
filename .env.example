# Copy to .env and fill in. .env is gitignored -- never commit real secrets.

# ---------------------------------------------------------------- database
# Single-file SQLite database (sqlite-vec vectors + FTS5 text). No daemon.
APSEARCH_SQLITE_PATH=data/areios_pagos.db

# --------------------------------------------------------------- embedding
# "gemini" (hosted; fast, best Greek quality) or "fastembed" (local ONNX, no key)
APSEARCH_EMBED_BACKEND=gemini
APSEARCH_EMBED_DIM=768
APSEARCH_GEMINI_EMBED_MODEL=gemini-embedding-2
APSEARCH_GEMINI_CONCURRENCY=4
# Secret. Locally: put it here.
APSEARCH_GEMINI_API_KEY=

# Fully-open-source alternative (no API key, ~4 chunks/s on 4 vCPU):
# APSEARCH_EMBED_BACKEND=fastembed
# APSEARCH_EMBED_DIM=384
# APSEARCH_EMBED_MODEL=intfloat/multilingual-e5-small

# ----------------------------------------------------------------- crawler
# Strongly recommended: lets the site's operators contact you rather than block you.
APSEARCH_CONTACT_EMAIL=
APSEARCH_CRAWL_DELAY=2.0
# Safety net against a runaway job (0 = unlimited)
APSEARCH_MAX_REQUESTS_PER_RUN=0

# ------------------------------------------------------------------- cache
APSEARCH_CACHE_BACKEND=local
APSEARCH_CACHE_DIR=data/http_cache
